
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model user {
  id    Int     @id @default(autoincrement())
  nome  String?
  sobrenome String?
  email String  @unique
  senha String
  criado DateTime @default(now())
}